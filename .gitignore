# --- Dependencies and build output ---
node_modules/
dist/
build/
target/
.vercel/
.firebase/
.vite/
coverage/
*.tsbuildinfo

# --- Secrets and machine-local config ---
.env*
secrets.txt
# Per-machine permission allow-list with absolute user paths. Shared settings
# belong in .claude/settings.json.
.claude/settings.local.json

# --- Logs ---
*.log

# --- OS and editor cruft ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp
# Windows device name; `cmd > nul` inside Git Bash creates a real file.
nul

# --- Local agent / tool state ---
.claude/worktrees/
.agents/
# The Agent tool's dev-only model-request log (apps/studio/vite.config.ts).
.agent/
# Same log under its pre-rename name; the directory survives the rename.
.code-beta/
# Autogenerated Codex environment, points at this machine's paths.
.codex/
# Local desktop database, not referenced by any source file.
.freebuff/
# Scratch state for the in-flight monorepo restructure.
.refactor-tmp/

# --- Generated screenshots and scratch output ---
# tools/scripts/archive-ui-research.mjs classifies both of these as generated
# output that is safe to drop.
.playwright-cli/
output/

# --- Personal data ---
# Gemini debug dumps contain the user's real name, birthdate and email bodies.
Debug Info*.txt
# The whole UI-research tree is local-only. The captures are verbatim page dumps
# and screenshots of signed-in Google surfaces, carrying the account's email,
# avatar and task titles plus third-party source we have no licence to
# redistribute. The scrapers that produce them are excluded too: they drive a
# live signed-in browser session against a specific build of someone else's
# site, so they are not reproducible or useful outside this machine, and nothing
# in the app imports them. tools/scripts/archive-ui-research.mjs manages it.
tools/ui-research/

# --- Root-level scratch files ---
fun_facts_about_antigravity.txt
/*-diff.txt
/*_diff.txt
/chatview_*.tsx
# Stray hashed bundle chunks dropped at the repo root by other apps.
/codex-pet-assets-*
/createLucideIcon-*.js
/goal-*.js
