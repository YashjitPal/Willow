{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Willow",
  "version": "0.1.0",
  "identifier": "com.willow.studio",
  "build": {
    "frontendDist": "../shell"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Willow",
    "longDescription": "Willow: chat, code, media and Spark with always-on dots, on your own computer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/willow-node"],
    "resources": {
      "../build/willow/": "willow/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "./Entitlements.plist"
    }
  }
}
