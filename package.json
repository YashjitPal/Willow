{
  "name": "willow",
  "version": "0.1.0",
  "private": true,
  "description": "Willow — a local-first super-app: Code, Chat, Media, Design, Agents.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "comment": "One npm project for the whole browser side: apps/ + features/ + platform/ all share this dependency set and the single node_modules at the repo root. The Node backends under services/ are separate packages with their own deps, because they ship independently.",
  "scripts": {
    "dev": "npm --prefix apps/studio run dev",
    "build": "npm --prefix apps/studio run build",
    "build:no-env": "npm --prefix apps/studio run build:no-env",
    "preview": "npm --prefix apps/studio run preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "npm --prefix apps/studio run test",
    "agent-builder:start": "npm --prefix services/agent-builder start",
    "agent-builder:test": "npm --prefix services/agent-builder test",
    "agent-builder:typecheck": "npm --prefix services/agent-builder run typecheck",
    "companion:start": "npm --prefix services/local-companion start",
    "companion:test": "npm --prefix services/local-companion test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@google/genai": "^1.38.0",
    "@google/generative-ai": "^0.24.1",
    "@nanostores/persistent": "^1.3.5",
    "@nanostores/react": "^0.7.3",
    "@octokit/rest": "^22.0.1",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@typescript-eslint/parser": "^8.62.1",
    "@xyflow/react": "^12.10.1",
    "browser-id3-writer": "^6.3.1",
    "canvas": "^3.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^8.0.2",
    "dotenv": "^17.3.1",
    "esbuild-wasm": "^0.27.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "file-saver": "^2.0.5",
    "firebase": "^12.15.0",
    "framer-motion": "^12.34.3",
    "highlight.js": "^11.11.1",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "js-cookie": "^3.0.5",
    "jszip": "^3.10.1",
    "katex": "^0.18.1",
    "lottie-web": "^5.13.0",
    "lucide-react": "^0.562.0",
    "nanostores": "^0.10.3",
    "openai": "^6.15.0",
    "path-browserify": "^1.0.1",
    "puppeteer": "^25.4.0",
    "puppeteer-core": "^25.4.0",
    "puppeteer-screen-recorder": "^3.0.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.11.0",
    "recast": "^0.23.11",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "tailwind-merge": "^3.4.0",
    "ts-morph": "^27.0.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@babel/generator": "^7.28.6",
    "@babel/parser": "^7.28.6",
    "@babel/traverse": "^7.28.6",
    "@babel/types": "^7.28.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
