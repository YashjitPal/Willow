', label: 'Serbian', nativeLabel: 'Српски' },\n  { code: 'bs', label: 'Bosnian', nativeLabel: 'Bosanski' },\n  { code: 'cnr', label: 'Montenegrin', nativeLabel: 'Crnogorski' },\n  { code: 'bg', label: 'Bulgarian', nativeLabel: 'Български' },\n  { code: 'ro', label: 'Romanian', nativeLabel: 'Română' },\n  { code: 'hu', label: 'Hungarian', nativeLabel: 'Magyar' },\n  { code: 'el', label: 'Greek', nativeLabel: 'Ελληνικά' },\n  { code: 'sq', label: 'Albanian', nativeLabel: 'Shqip' },\n  { code: 'uk', label: 'Ukrainian', nativeLabel: 'Українська' },\n  { code: 'be', label: 'Belarusian', nativeLabel: 'Беларуская' },\n  { code: 'lt', label: 'Lithuanian', nativeLabel: 'Lietuvių' },\n  { code: 'lv', label: 'Latvian', nativeLabel: 'Latviešu' },\n  { code: 'et', label: 'Estonian', nativeLabel: 'Eesti' },\n  { code: 'ga', label: 'Irish', nativeLabel: 'Gaeilge' },\n  { code: 'cy', label: 'Welsh', nativeLabel: 'Cymraeg' },\n  { code: 'gd', label: 'Scottish Gaelic', nativeLabel: 'Gàidhlig' },\n  { code: 'ca', label: 'Catalan', nativeLabel: 'Català' },\n  { code: 'eu', label: 'Basque', nativeLabel: 'Euskara' },\n  { code: 'gl', label: 'Galician', nativeLabel: 'Galego' },\n  { code: 'mt', label: 'Maltese', nativeLabel: 'Malti' },\n  { code: 'lb', label: 'Luxembourgish', nativeLabel: 'Lëtzebuergesch' },\n  { code: 'he', label: 'Hebrew', nativeLabel: 'עברית' },\n  { code: 'ku', label: 'Kurdish', nativeLabel: 'Kurdî' },\n  { code: 'ckb', label: 'Sorani Kurdish', nativeLabel: 'سۆرانی' },\n  { code: 'ps', label: 'Pashto', nativeLabel: 'پښتو' },\n  { code: 'prs', label: 'Dari', nativeLabel: 'دری' },\n  { code: 'hy', label: 'Armenian', nativeLabel: 'Հայերեն' },\n  { code: 'ka', label: 'Georgian', nativeLabel: 'ქ�����თუ�����' },\n  { code: 'az', label: 'Azerbaijani', nativeLabel: 'Azərbaycanca' },\n  { code: 'kk', label: 'Kazakh', nativeLabel: 'Қазақша' },\n  { code: 'uz', label: 'Uzbek', nativeLabel: 'Oʻzbekcha' },\n  { code: 'ky', label: 'Kyrgyz', nativeLabel: 'Кыргызча' },\n  { code: 'tk', label: 'Turkmen', nativeLabel: 'Türkmençe' },\n  { code: 'tg', label: 'Tajik', nativeLabel: 'Тоҷикӣ' }\n];"},{"path":"components/LanguageGate.tsx","content":"import React, { useState } from 'react';\nimport { SUPPORTED_LANGUAGES } from '../constants/Languages';\nimport { LanguageCode } from '../types';\nimport { TRANSLATIONS } from '../translations';\n\ninterface Props {\n  onSelect: (code: LanguageCode) => void;\n}\n\nexport const LanguageGate: React.FC<Props> = ({ onSelect }) => {\n  const [selected, setSelected] = useState<LanguageCode>('en');\n  const t = TRANSLATIONS[selected] || TRANSLATIONS['en'];\n\n  return (\n    <div className=\"fixed inset-0 z-[100] flex items-center justify-center bg-[#fcfcfc] graph-paper p-4 md:p-10 overflow-y-auto\">\n      <div className=\"w-full max-w-5xl bg-white rounded-[48px] border-4 border-slate-200 shadow-2xl flex flex-col lg:flex-row overflow-hidden animate-in fade-in zoom-in-95 duration-700 relative\">\n        \n        {/* Left: Welcome Content */}\n        <div className=\"flex-1 bg-slate-900 p-10 md:p-16 text-white flex flex-col justify-center gap-10\">\n          <div className=\"flex flex-col gap-4\">\n            <div className=\"w-16 h-16 bg-[#21a351] rounded-2xl flex items-center justify-center shadow-lg rotate-3\">\n              <span className=\"material-symbols-outlined text-white text-4xl font-black\">architecture</span>\n            </div>\n            <h1 className=\"text-4xl md:text-5xl font-black tracking-tight leading-tight\">\n              {t.welcomeTitle}\n            </h1>\n            <p className=\"text-slate-400 text-lg font-medium leading-relaxed max-w-md\">\n              {t.welcomeIntro}\n            </p>\n          </div>\n\n          <div className=\"flex flex-col gap-8\">\n            {/* Clearer Step 1 */}\n            <div className=\"flex items-start gap-4 group\">\n              <div className=\"w-12 h-12 shrink-0 rounded-full border-2 border-white/20 flex items-center justify-center group-hover:border-[#21a351] group-hover:text-[#21a351] transition-all bg-slate-800\">\n                <span className=\"material-symbols-outlined text-xl\">language</span>\n              </div>\n              <div className=\"flex flex-col gap-1\">\n                <span className=\"text-sm font-black uppercase tracking-widest text-slate-100\">{t.welcomeStep1}</span>\n                <p className=\"text-xs font-medium text-slate-400 leading-relaxed max-w-xs\">{t.welcomeStep1Sub}</p>\n              </div>\n            </div>\n\n            {/* Clearer Step 2 */}\n            <div className=\"flex items-start gap-4 group\">\n              <div className=\"w-12 h-12 shrink-0 rounded-full border-2 border-white/20 flex items-center justify-center group-hover:border-[#21a351] group-hover:text-[#21a351] transition-all bg-slate-800\">\n                <span className=\"material-symbols-outlined text-xl\">palette</span>\n              </div>\n              <div className=\"flex flex-col gap-1\">\n                <span className=\"text-sm font-black uppercase tracking-widest text-slate-100\">{t.welcomeStep2}</span>\n                <p className=\"text-xs font-medium text-slate-400 leading-relaxed max-w-xs\">{t.welcomeStep2Sub}</p>\n              </div>\n            </div>\n\n            {/* Clearer Step 3 */}\n            <div className=\"flex items-start gap-4 group\">\n              <div className=\"w-12 h-12 shrink-0 rounded-full border-2 border-white/20 flex items-center justify-center group-hover:border-[#21a351] group-hover:text-[#21a351] transition-all bg-slate-800\">\n                <span className=\"material-symbols-outlined text-xl\">auto_awesome</span>\n              </div>\n              <div className=\"flex flex-col gap-1\">\n                <span className=\"text-sm font-black uppercase tracking-widest text-slate-100\">{t.welcomeStep3}</span>\n                <p className=\"text-xs font-medium text-slate-400 leading-relaxed max-w-xs\">{t.welcomeStep3Sub}</p>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Right: Language Selection */}\n        <div className=\"flex-1 p-10 md:p-16 flex flex-col justify-center gap-10 bg-white\">\n          <div className=\"flex flex-col gap-3\">\n            <h2 className=\"text-3xl font-black text-slate-900 tracking-tight\">{t.languageSelectTitle}</h2>\n            <p className=\"text-slate-500 font-bold text-sm leading-relaxed\">\n              {t.languageSelectSub}\n            </p>\n          </div>\n\n          <div className=\"flex flex-col gap-2\">\n            <label className=\"text-[12px] font-black text-slate-400 uppercase tracking-widest pl-3\">\n              {selected === 'en' ? 'Choose Region' : SUPPORTED_LANGUAGES.find(l => l.code === selected)?.label}\n            </label>\n            <div className=\"relative group\">\n              <select\n                value={selected}\n                onChange={(e) => setSelected(e.target.value)}\n                className=\"w-full h-[80px] bg-slate-100 border-2 border-slate-200 hover:border-[#21a351] focus:border-[#21a351] rounded-[32px] px-8 text-slate-900 font-black text-2xl appearance-none outline-none transition-all cursor-pointer shadow-inner\"\n              >\n                {SUPPORTED_LANGUAGES.map((lang) => (\n                  <option key={lang.code} value={lang.code}>\n                    {lang.nativeLabel} — {lang.label}\n                  </option>\n                ))}\n              </select>\n              <span className=\"material-symbols-outlined absolute right-8 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none group-hover:text-[#21a351] transition-colors font-bold\">\n                unfold_more\n              </span>\n            </div>\n          </div>\n\n          <button\n            onClick={() => onSelect(selected)}\n            className=\"w-full h-20 bg-[#21a351] text-white rounded-[32px] font-black text-2xl flex items-center justify-center gap-4 hover:bg-[#1a8a44] active:scale-[0.98] transition-all shadow-2xl shadow-green-100 uppercase tracking-widest\"\n          >\n            {t.languageSelectAction}\n            <span className=\"material-symbols-outlined font-black text-4xl\">arrow_right_alt</span>\n          </button>\n\n          <div className=\"flex justify-center gap-3\">\n            <div className=\"w-12 h-1.5 rounded-full bg-[#21a351]\" />\n            <div className=\"w-12 h-1.5 rounded-full bg-slate-100\" />\n            <div className=\"w-12 h-1.5 rounded-full bg-slate-100\" />\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};"},{"path":"components/Step1VideoGen.tsx","content":"import React, { useState, useEffect } from 'react';\nimport { Flow } from 'flow-sdk';\nimport { COLLAGE_STYLES } from '../constants/StyleLibrary';\nimport { SUPPORTED_LANGUAGES } from '../constants/Languages';\nimport { GeneratedVideo, LanguageCode, TranslationStrings } from '../types';\n\ninterface Props {\n  onVideoGen: (video: GeneratedVideo) => void;\n  langCode: LanguageCode;\n  t: TranslationStrings;\n  aspectRatio: '16:9' | '9:16';\n  setAspectRatio: (ratio: '16:9' | '9:16') => void;\n}\n\nconst RangeSlider: React.FC<{\n  label: string; value: number; min: number; max: number;\n  step?: number; formatValue?: (val: number) => string;\n  onChange: (val: number) => void;\n}> = ({ label, value, min, max, step = 1, formatValue = (v) => String(v), onChange }) => (\n  <div className=\"flex flex-col gap-4 pt-2 pb-[5px] w-full\">\n    <div className=\"flex items-center justify-between px-1 select-none\">\n      <span className=\"text-[12px] font-black text-slate-400 uppercase tracking-widest\">{label}</span>\n      <span className=\"text-xs font-black text-white bg-[#21a351] px-3 py-1 rounded-full shadow-sm\">{formatValue(value)}</span>\n    </div>\n    <div className=\"px-1 w-full flex items-center h-2 group\">\n      <input \n        type=\"range\" \n        min={min} \n        max={max} \n        step={step} \n        value={value}\n        onChange={(e) => onChange(Number(e.target.value))}\n        className=\"w-full h-2 bg-slate-200 rounded-full appearance-none cursor-pointer accent-[#21a351] hover:accent-[#1a8a44] transition-all\"\n      />\n    </div>\n  </div>\n);\n\nconst SegmentedControl: React.FC<{\n  value: string;\n  items: { value: string; label: string; icon?: string; disabled?: boolean }[];\n  onChange: (val: any) => void;\n  onDisabledClick?: (item: any) => void;\n  label?: string;\n}> = ({ value, items, onChange, onDisabledClick, label }) => (\n  <div className=\"flex flex-col gap-3 flex-1\">\n    {label && <label className=\"text-[11px] font-black text-slate-400 uppercase tracking-widest pl-2\">{label}</label>}\n    <div className=\"flex w-full items-center border-2 border-slate-200 rounded-[20px] overflow-hidden bg-slate-100 p-1.5 shadow-inner\">\n      {items.map(item => (\n        <button\n          key={item.value}\n          onClick={() => item.disabled ? onDisabledClick?.(item) : onChange(item.value)}\n          className={`flex-1 h-11 rounded-[14px] text-[10px] font-black tracking-widest transition-all flex items-center justify-center gap-2 ${\n            value === item.value \n              ? 'bg-white text-[#21a351] shadow-sm' \n              : item.disabled \n                ? 'text-slate-300 cursor-default' \n                : 'text-slate-500 hover:text-slate-900 hover:bg-white/50'\n          }`}\n        >\n          {item.icon && <span className=\"material-symbols-outlined text-[18px] font-bold\">{item.icon}</span>}\n          {item.label}\n        </button>\n      ))}\n    </div>\n  </div>\n);\n\nexport const Step1VideoGen: React.FC<Props> = ({ \n  onVideoGen, \n  langCode, \n  t,\n  aspectRatio,\n  setAspectRatio\n}) => {\n  const [sceneDescription, setSceneDescription] = useState('');\n  const [script, setScript] = useState('');\n  const [autoGenerateScript, setAutoGenerateScript] = useState(false);\n  const [style, setStyle] = useState(COLLAGE_STYLES[0].id);\n  const [duration, setDuration] = useState(8); \n  const [narration, setNarration] = useState<'female' | 'male' | 'none'>('none');\n  const [useMusic, setUseMusic] = useState(true);\n  const [loading, setLoading] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n\n  const voiceDisabled = !autoGenerateScript && !script.trim();\n\n  useEffect(() => {\n    if (voiceDisabled && narration !== 'none') {\n      setNarration('none');\n    }\n  }, [voiceDisabled, narration]);\n\n  // Auto-hide error toast\n  useEffect(() => {\n    if (error) {\n      const timer = setTimeout(() => setError(null), 4000);\n      return () => clearTimeout(timer);\n    }\n  }, [error]);\n\n  const handleDisabledVoiceClick = () => {\n    setError(t.errorVoiceScript);\n  };\n\n  const handleGenerate = async () => {\n    if (!sceneDescription.trim()) {\n      setError(t.errorInput);\n      return;\n    }\n\n    setError(null);\n    setLoading(true);\n    \n    try {\n      const selectedStyle = COLLAGE_STYLES.find(s => s.id === style);\n      const langLabel = SUPPORTED_LANGUAGES.find(l => l.code === langCode)?.label || 'English';\n      \n      let finalScript = script.trim();\n\n      if (autoGenerateScript) {\n        const { text: generatedText } = await Flow.generate.text(\n          `Write a short, cinematic 1-2 sentence script to be spoken by a narrator for a collage-art video. The video describes: ${sceneDescription}. Keep it poetic, brief, and in the ${langLabel} language.`,\n          { systemInstruction: `You are a scriptwriter for high-end collage-style art videos. Always respond in the requested language.` }\n        );\n        finalScript = generatedText.trim();\n      }\n      \n      const narrationInstruction = narration === 'none' \n        ? \"No spoken narration. Immersive environmental sound effects only.\"\n        : `Feature a clear, expressive ${narration} narrator voiceover reading this script verbatim: \"${finalScript}\". Language: ${langLabel}.`;\n      \n      const musicInstruction = useMusic \n        ? \"Layered with a rhythmic, atmospheric background music score that complements the tactile paper aesthetic.\"\n        : \"No background music, focusing purely on tactile sound design.\";\n\n      const fullPrompt = `\n        A masterfully crafted paper collage video about: ${sceneDescription}. \n        Core Narrative Script: \"${finalScript}\".\n        Style: ${selectedStyle?.definition}. \n        Motion: Tactile stop-motion animation, individual paper scraps sliding and fluttering, jittery paper shadows, 3D parallax depth, ink drawings appearing.\n        All text, labels, and handwriting elements displayed in the scene must be in the ${langLabel} language.\n        Audio: ${narrationInstruction} ${musicInstruction}\n        Cinematic framing, high-end editorial collage aesthetic, sharp paper textures and extreme material detail.\n      `;\n\n      const result = await Flow.generate.video({\n        prompt: fullPrompt,\n        aspectRatio: aspectRatio,\n        modelDisplayName: 'Omni 1.1 Flash',\n        durationSeconds: duration\n      });\n\n      onVideoGen({\n        mediaId: result.mediaId,\n        base64: result.base64,\n        mimeType: result.mimeType,\n        duration: duration\n      });\n    } catch (err) {\n      console.error(err);\n      setError(t.errorGen);\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  return (\n    <div className=\"flex flex-col gap-8 w-full max-w-4xl mx-auto p-10 bg-white rounded-[40px] border-2 border-slate-200 shadow-2xl relative overflow-hidden group\">\n      <div className=\"absolute inset-0 animate-shimmer-light opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none\" />\n      \n      <div className=\"flex items-center gap-5 mb-2 relative z-10\">\n        <div className=\"w-14 h-14 rounded-2xl bg-slate-900 text-white flex items-center justify-center font-black shadow-xl text-2xl border-4 border-white\">01</div>\n        <div className=\"flex flex-col\">\n          <h2 className=\"text-2xl font-black text-slate-900 tracking-tight leading-tight uppercase\">{t.step1Title}</h2>\n          <span className=\"text-[12px] font-black text-slate-400 uppercase tracking-widest\">{t.step1Sub}</span>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-12 relative z-10\">\n        <div className=\"flex flex-col gap-8\">\n          <div className=\"flex flex-col gap-3\">\n            <label className=\"text-[12px] font-black text-slate-400 uppercase tracking-widest pl-3\">{t.sceneLabel}</label>\n            <textarea\n              value={sceneDescription}\n              onChange={(e) => setSceneDescription(e.target.value)}\n              placeholder={t.scenePlaceholder}\n              className=\"w-full h-32 bg-slate-100 border-2 border-slate-200 rounded-3xl p-6 text-sm font-semibold text-slate-900 focus:border-[#21a351] focus:bg-white outline-none transition-all resize-none light-scrollbar placeholder:text-slate-400 placeholder:font-normal placeholder:opacity-70 shadow-inner\"\n            />\n          </div>\n\n          <div className=\"flex flex-col gap-3\">\n            <div className=\"flex items-center justify-between px-3\">\n              <label className=\"text-[12px] font-black text-slate-400 uppercase tracking-widest\">{t.scriptLabel}</label>\n              <button \n                onClick={() => setAutoGenerateScript(!autoGenerateScript)}\n                className={`flex items-center gap-2 px-4 py-2 rounded-2xl border-2 transition-all ${\n                  autoGenerateScript \n                    ? 'bg-green-50 border-[#21a351] text-[#21a351]' \n                    : 'bg-white border-slate-200 text-slate-400 hover:text-slate-900 hover:border-slate-300'\n                }`}\n              >\n                <span className=\"material-symbols-outlined text-[18px] font-bold\">\n                  {autoGenerateScript ? 'check_circle' : 'add_circle'}\n                </span>\n                <span className=\"text-[11px] font-black uppercase tracking-widest\">{t.autoGenScript}</span>\n              </button>\n            </div>\n            <textarea\n              value={script}\n              disabled={autoGenerateScript}\n              onChange={(e) => setScript(e.target.value)}\n              placeholder={autoGenerateScript ? \"AI is standing by to write your script...\" : t.scriptPlaceholder}\n              className={`w-full h-32 bg-slate-100 border-2 border-slate-200 rounded-3xl p-6 text-sm font-semibold text-slate-900 outline-none transition-all resize-none light-scrollbar placeholder:text-slate-400 placeholder:font-normal placeholder:opacity-70 shadow-inner ${\n                autoGenerateScript ? 'opacity-50 cursor-not-allowed border-dashed' : 'focus:border-[#21a351] focus:bg-white'\n              }`}\n            />\n          </div>\n\n          <div className=\"flex flex-col gap-3\">\n            <label className=\"text-[12px] font-black text-slate-400 uppercase tracking-widest pl-3\">{t.styleLabel}</label>\n            <div className=\"relative group/select\">\n              <select\n                value={style}\n                onChange={(e) => setStyle(e.target.value)}\n                className=\"w-full h-16 bg-slate-100 border-2 border-slate-200 rounded-3xl px-6 text-sm font-black text-slate-900 focus:border-[#21a351] focus:bg-white outline-none cursor-pointer appearance-none transition-all shadow-inner\"\n              >\n                {COLLAGE_STYLES.map(s => (\n                  <option key={s.id} value={s.id}>{s.name[langCode] || s.name['en']}</option>\n                ))}\n              </select>\n              <span className=\"material-symbols-outlined absolute right-6 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none group-hover/select:text-[#21a351] transition-colors font-bold\">\n                unfold_more\n              </span>\n            </div>\n          </div>\n        </div>\n\n        <div className=\"flex flex-col gap-8\">\n          <div className=\"p-8 bg-slate-100 rounded-[32px] border-2 border-slate-200 flex flex-col gap-7 shadow-inner\">\n            <div className=\"flex items-center gap-3 mb-1 px-1\">\n              <div className=\"w-8 h-8 rounded-lg bg-[#21a351] flex items-center justify-center\">\n                <span className=\"material-symbols-outlined text-white text-[20px] font-bold\">graphic_eq</span>\n              </div>\n              <span className=\"text-[12px] font-black text-slate-500 uppercase tracking-widest\">{t.audioTitle}</span>\n            </div>\n            \n            <SegmentedControl \n              label={t.voiceLabel}\n              value={narration}\n              onChange={setNarration}\n              onDisabledClick={handleDisabledVoiceClick}\n              items={[\n                { value: 'female', label: t.voiceFemale, icon: 'face_3', disabled: voiceDisabled },\n                { value: 'male', label: t.voiceMale, icon: 'face', disabled: voiceDisabled },\n                { value: 'none', label: t.voiceNone, icon: 'volume_off' }\n              ]}\n            />\n\n            <SegmentedControl \n              label={t.musicLabel}\n              value={useMusic ? 'on' : 'off'}\n              onChange={(val) => setUseMusic(val === 'on')}\n              items={[\n                { value: 'on', label: t.musicOn, icon: 'music_note' },\n                { value: 'off', label: t.musicOff, icon: 'music_off' }\n              ]}\n            />\n          </div>\n\n          <div className=\"grid grid-cols-1 gap-6\">\n            <div className=\"flex flex-col gap-2 p-6 bg-white border-2 border-slate-200 rounded-[32px] shadow-sm\">\n              <RangeSlider \n                label={t.durationLabel}\n                value={duration}\n                min={3}\n                max={10}\n                step={1}\n                formatValue={(v) => `${v}s`}\n                onChange={setDuration}\n              />\n            </div>\n          </div>\n\n          <div className=\"flex flex-col gap-3\">\n            <label className=\"text-[12px] font-black text-slate-400 uppercase tracking-widest pl-3\">{t.aspectLabel}</label>\n            <div className=\"flex w-full items-center border-2 border-slate-200 rounded-[24px] overflow-hidden bg-slate-100 p-1.5 shadow-inner\">\n              {(['16:9', '9:16'] as const).map(ratio => (\n                <button\n                  key={ratio}\n                  type=\"button\"\n                  onClick={() => setAspectRatio(ratio)}\n                  className={`flex-1 h-16 rounded-[18px] flex flex-col items-center justify-center gap-1 transition-all group/ratio ${\n                    aspectRatio === ratio \n                      ? 'bg-[#21a351] text-white shadow-xl scale-[1.02]' \n                      : 'text-slate-500 hover:text-slate-900 hover:bg-white/50'\n                }`}\n                >\n                  <div className={`border-2 rounded-sm mb-0.5 ${\n                    aspectRatio === ratio ? 'border-white' : 'border-slate-300 group-hover/ratio:border-slate-500'\n                  }`} \n                  style={{ \n                    width: ratio === '16:9' ? '22px' : '12px',\n                    height: ratio === '16:9' ? '12px' : '22px'\n                  }} />\n                  <span className=\"text-[10px] font-black tracking-widest\">{ratio === '16:9' ? 'LANDSCAPE' : 'PORTRAIT'}</span>\n                </button>\n              ))}\n            </div>\n          </div>\n\n          <button\n            onClick={handleGenerate}\n            disabled={loading}\n            className=\"w-full h-20 mt-4 rounded-[32px] bg-slate-900 text-white font-black text-lg uppercase tracking-[0.2em] flex items-center justify-center gap-4 hover:bg-black active:scale-[0.98] transition-all disabled:opacity-50 shadow-2xl group/btn\"\n          >\n            {loading ? (\n              <>\n                <span className=\"material-symbols-outlined animate-spin text-[32px]\">progress_activity</span>\n                {t.genLoading}\n              </>\n            ) : (\n              <>\n                <span className=\"material-symbols-outlined text-[32px] group-hover/btn:rotate-12 transition-transform\">movie_filter</span>\n                {t.genBtn}\n              </>\n            )}\n          </button>\n        </div>\n      </div>\n\n      {/* Floating Error Toast */}\n      {error && (\n        <div className=\"fixed top-8 left-1/2 -translate-x-1/2 z-[200] flex items-center gap-4 px-8 py-5 bg-white border-2 border-red-100 rounded-[32px] shadow-[0_20px_60px_rgba(0,0,0,0.15)] animate-in slide-in-from-top-8 fade-in duration-500 min-w-[320px]\">\n           <div className=\"w-10 h-10 rounded-2xl bg-red-500 flex items-center justify-center shadow-lg rotate-3\">\n             <span className=\"material-symbols-outlined text-white text-[24px] font-black\">priority_high</span>\n           </div>\n           <div className=\"flex flex-col\">\n              <span className=\"text-[10px] font-black text-red-400 uppercase tracking-widest leading-none mb-1\">Notice</span>\n              <span className=\"text-sm font-black text-slate-900 uppercase tracking-tight\">{error}</span>\n           </div>\n           <button \n            onClick={() => setError(null)}\n            className=\"ml-auto w-8 h-8 rounded-full flex items-center justify-center hover:bg-slate-50 transition-colors\"\n           >\n             <span className=\"material-symbols-outlined text-slate-300 text-[18px]\">close</span>\n           </button>\n        </div>\n      )}\n    </div>\n  );\n};"},{"path":"components/Step2Preview.tsx","content":"import React, { useState, useEffect } from 'react';\nimport { Flow } from 'flow-sdk';\nimport { GeneratedVideo, TranslationStrings } from '../types';\n\ninterface Props {\n  video: GeneratedVideo | null;\n  t: TranslationStrings;\n  aspectRatio: string;\n}\n\nexport const Step2Preview: React.FC<Props> = ({ video, t, aspectRatio }) => {\n  const [downloadState, setDownloadState] = useState<'idle' | 'downloading' | 'done'>('idle');\n  const [blobUrl, setBlobUrl] = useState<string | null>(null);\n\n  useEffect(() => {\n    if (video) {\n      const byteCharacters = atob(video.base64);\n      const byteArrays = [];\n      for (let offset = 0; offset < byteCharacters.length; offset += 512) {\n        const slice = byteCharacters.slice(offset, offset + 512);\n        const byteNumbers = new Array(slice.length);\n        for (let i = 0; i < slice.length; i++) byteNumbers[i] = slice.charCodeAt(i);\n        byteArrays.push(new Uint8Array(byteNumbers));\n      }\n      const blob = new Blob(byteArrays, { type: video.mimeType });\n      const url = URL.createObjectURL(blob);\n      setBlobUrl(url);\n      return () => URL.revokeObjectURL(url);\n    } else {\n      setBlobUrl(null);\n    }\n  }, [video]);\n\n  const handleDownload = async () => {\n    if (!video) return;\n    setDownloadState('downloading');\n    try {\n      await Flow.download({\n        base64: video.base64,\n        mimeType: video.mimeType,\n        filename: `collage_video_${Date.now()}.mp4`\n      });\n      setDownloadState('done');\n      setTimeout(() => setDownloadState('idle'), 3000);\n    } catch (err) {\n      console.error(err);\n      setDownloadState('idle');\n    }\n  };\n\n  return (\n    <div className={`flex flex-col gap-8 w-full max-w-4xl mx-auto p-12 bg-white rounded-[48px] border-2 border-slate-200 shadow-2xl relative overflow-hidden transition-all duration-1000 ${!video ? 'opacity-40 grayscale blur-[4px] pointer-events-none scale-95' : 'scale-100'}`}>\n      <div className=\"flex items-center gap-5 mb-4 relative z-10\">\n        <div className=\"w-14 h-14 rounded-2xl bg-[#21a351] text-white flex items-center justify-center font-black shadow-xl text-2xl border-4 border-white\">02</div>\n        <div className=\"flex flex-col\">\n          <h2 className=\"text-2xl font-black text-slate-900 tracking-tight leading-tight\">{t.step2Title}</h2>\n          <span className=\"text-[12px] font-black text-slate-400 uppercase tracking-widest\">{t.step2Sub}</span>\n        </div>\n      </div>\n\n      <div className=\"flex flex-col lg:flex-row gap-16 relative z-10\">\n        <div className=\"flex-1 flex flex-col gap-10\">\n          <div className=\"relative\">\n             <div className=\"absolute -left-5 top-0 w-1.5 h-full bg-[#21a351] rounded-full opacity-30\" />\n             <p className=\"text-lg text-slate-600 leading-relaxed font-bold\">\n               {t.step2Desc}\n             </p>\n          </div>\n\n          <div className=\"grid grid-cols-1 gap-6\">\n            <div className=\"px-8 py-7 bg-slate-100 border-2 border-slate-200 rounded-[32px] flex flex-col gap-1 shadow-inner\">\n               <span className=\"text-[11px] font-black text-slate-400 uppercase tracking-widest\">{t.aspectLabel}</span>\n               <span className=\"text-2xl font-black text-slate-900\">{aspectRatio}</span>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-4 px-6 py-5 bg-green-50 border-2 border-green-100 rounded-3xl\">\n             <span className=\"material-symbols-outlined text-[#21a351] font-black text-2xl\">verified</span>\n             <span className=\"text-[12px] font-black text-[#21a351] uppercase tracking-widest leading-tight\">\n               Neural Engine • {video?.duration}s High-Fidelity Collage Exported\n             </span>\n          </div>\n\n          <button\n            onClick={handleDownload}\n            disabled={!video || downloadState === 'downloading'}\n            className={`h-20 rounded-[32px] font-black text-lg uppercase tracking-[0.2em] flex items-center justify-center gap-4 transition-all shadow-2xl active:scale-95 ${\n              downloadState === 'done' ? 'bg-[#1a8a44] text-white' : 'bg-slate-900 text-white hover:bg-black'\n            }`}\n          >\n            <span className=\"material-symbols-outlined text-[32px] font-black\">\n              {downloadState === 'downloading' ? 'hourglass_top' : downloadState === 'done' ? 'check_circle' : 'download'}\n            </span>\n            {downloadState === 'downloading' ? 'Finalizing...' : downloadState === 'done' ? 'Done' : t.downloadVideo}\n          </button>\n        </div>\n\n        <div className=\"w-full lg:w-[420px] aspect-square bg-slate-100 rounded-[48px] border-8 border-white overflow-hidden relative flex flex-col items-center justify-center shadow-2xl ring-2 ring-slate-100\">\n          <div className=\"absolute inset-0 bg-[radial-gradient(circle,rgba(255,255,255,1)_0%,rgba(248,250,252,1)_100%)] pointer-events-none\" />\n          {blobUrl ? (\n            <video \n              autoPlay \n              loop \n              controls\n              className=\"w-full h-full object-contain relative z-10\"\n              src={blobUrl}\n            />\n          ) : (\n            <div className=\"flex flex-col items-center gap-8 opacity-20 relative z-10\">\n              <span className=\"material-symbols-outlined text-9xl text-slate-400\">movie_edit</span>\n              <span className=\"text-xs font-black uppercase tracking-[0.5em] text-center px-12 leading-loose text-slate-500\">Processing Celluloid</span>\n            </div>\n          )}\n        </div>\n      </div>\n\n      {/* Decorative Elements */}\n      <div className=\"absolute -top-8 left-1/2 -translate-x-1/2 w-40 h-14 bg-green-500/10 rotate-3 border-2 border-green-500/20 backdrop-blur-sm pointer-events-none rounded-sm\" />\n      <div className=\"absolute -bottom-8 right-10 w-24 h-24 bg-[#21a351] opacity-5 rounded-full blur-3xl pointer-events-none\" />\n    </div>\n  );\n};"}]}
