{"files":[{"path":"types.ts","content":"export type LanguageCode = string;\n\nexport interface LanguageInfo {\n  code: LanguageCode;\n  label: string;\n  nativeLabel: string;\n}\n\nexport interface CollageStyle {\n  id: string;\n  name: Record<string, string>;\n  definition: string;\n}\n\nexport interface GeneratedVideo {\n  mediaId: string;\n  base64: string;\n  mimeType: string;\n  duration: number;\n}\n\nexport interface TranslationStrings {\n  languageSelectTitle: string;\n  languageSelectSub: string;\n  languageSelectAction: string;\n  welcomeTitle: string;\n  welcomeIntro: string;\n  welcomeStep1: string;\n  welcomeStep1Sub: string;\n  welcomeStep2: string;\n  welcomeStep2Sub: string;\n  welcomeStep3: string;\n  welcomeStep3Sub: string;\n  headerTitle: string;\n  headerSub: string;\n  step1Title: string;\n  step1Sub: string;\n  inputLabel: string;\n  inputPlaceholder: string;\n  sceneLabel: string;\n  scenePlaceholder: string;\n  scriptLabel: string;\n  scriptPlaceholder: string;\n  autoGenScript: string;\n  styleLabel: string;\n  durationLabel: string;\n  aspectLabel: string;\n  audioTitle: string;\n  voiceLabel: string;\n  musicLabel: string;\n  voiceFemale: string;\n  voiceMale: string;\n  voiceNone: string;\n  musicOn: string;\n  musicOff: string;\n  genBtn: string;\n  genLoading: string;\n  errorInput: string;\n  errorGen: string;\n  errorVoiceScript: string;\n  step2Title: string;\n  step2Sub: string;\n  step2Desc: string;\n  downloadBtn: string;\n  downloadVideo: string;\n  shareTitle: string;\n  processingStage: string;\n  readyToDownload: string;\n}"},{"path":"constants/StyleLibrary.ts","content":"import { CollageStyle } from '../types';\n\nexport const COLLAGE_STYLES: CollageStyle[] = [\n  {\n    id: 'magazine',\n    name: {\n      en: 'Magazine cut-and-paste',\n      es: 'Recorte de revista',\n      ja: '雑�����切り�����',\n      vi: 'Cắt dán tạp chí'\n    },\n    definition: 'Layered taped paper scraps, marker scribbles, matte paper textures, off-white zine paper background, xerox grain, torn magazine fragments, hard white scissor-cut borders, visible glue marks, risograph ink, overlapping photo cutouts, rough handmade layout, analog print imperfections, subtle paper shadows, imperfect alignment, DIY editorial energy.'\n  },\n  {\n    id: 'punk',\n    name: {\n      en: 'Raw punk zine',\n      es: 'Zine punk crudo',\n      ja: '生�����ンク�����ン',\n      vi: 'Tạp chí punk thô'\n    },\n    definition: 'Photocopied paper texture, torn newspaper scraps, black marker scratches, safety pins, masking tape, ripped flyers, messy hand-cut edges, high-contrast xerox grain, distressed ink, bold anarchic composition, uneven layering, harsh shadows, smudged fingerprints, underground music magazine attitude, chaotic handmade rebellion.'\n  },\n  {\n    id: 'rock_poster',\n    name: {\n      en: '1970s vintage rock poster',\n      es: 'Póster de rock vintage años 70',\n      ja: '1970年�����ビン�����ジロ�����ポス�����',\n      vi: 'Áp phích rock cổ điển thập niên 70'\n    },\n    definition: 'Faded screen-printed ink, worn poster paper, bold graphic silhouettes, retro warm color palette, halftone shadows, hand-drawn lettering feel, slightly misregistered print layers, aged folds, sun-bleached edges, torn ticket stubs, vintage amplifier textures, nostalgic concert wall aesthetic.'\n  },\n  {\n    id: 'grunge',\n    name: {\n      en: 'Grunge scrapbook',\n      es: 'Álbum de recortes grunge',\n      ja: 'グ�����ジス�����ップ�����ク',\n      vi: 'Sổ lưu niệm grunge'\n    },\n    definition: 'Layered torn paper, dusty textures, coffee stains, yellowed tape, handwritten notes, distressed magazine clippings, dark smudges, rough paper fibers, scratched photo surfaces, imperfect handmade composition, moody analog atmosphere, emotional clutter, old notebook fragments, worn personal archive feeling.'\n  },\n  {\n    id: 'pop_art',\n    name: {\n      en: 'Pop art magazine',\n      es: 'Revista Pop Art',\n      ja: 'ポ�����アー�����ガジ���',\n      vi: 'Tạp chí nghệ thuật pop'\n    },\n    definition: 'Bold comic-book shapes, halftone dots, bright flat colors, thick black outlines, cut-out photo elements, graphic burst shapes, playful speech-bubble energy, glossy print texture, retro advertising influence, dramatic shadows, oversized objects, punchy layout, loud visual rhythm.'\n  },\n  {\n    id: 'minimal',\n    name: {\n      en: 'Minimal editorial',\n      es: 'Editorial mínima',\n      ja: 'ミ�����ル・�����ィト�����ル',\n      vi: 'Biên tập tối giản'\n    },\n    definition: 'Clean paper cutouts, refined magazine layout, soft realistic shadows, neutral background, elegant spacing, subtle paper texture, carefully arranged objects, modern art direction, premium print design, restrained color palette, sharp composition, quiet sophistication, polished gallery-like presentation.'\n  },\n  {\n    id: 'surreal',\n    name: {\n      en: 'Surreal paper cutout',\n      es: 'Recorte de papel surrealista',\n      ja: 'シ�����ルな�����絵',\n      vi: 'Cắt giấy siêu thực'\n    },\n    definition: 'Dreamlike scale shifts, floating torn-paper objects, mismatched textures, vintage magazine fragments, soft paper shadows, impossible composition, strange object combinations, analog surrealism, distorted proportions, poetic negative space, elegant weirdness, polished editorial dream logic.'\n  },\n  {\n    id: 'neon_cyber',\n    name: {\n      en: 'Neon cyber',\n      es: 'Cíber neón',\n      ja: 'ネ�����サイ�����',\n      vi: 'Không gian mạng neon'\n    },\n    definition: 'Glossy magazine cutouts, holographic paper, digital glitch textures, scanner streaks, chrome stickers, electric marker scribbles, layered transparent tape, futuristic zine layout, distorted photocopy grain, high contrast lighting, cyberpunk shapes, pixel noise, synthetic paper textures, nightclub poster energy.'\n  },\n  {\n    id: 'cassette',\n    name: {\n      en: 'Retro cassette mixtape',\n      es: 'Mixtape de casete retro',\n      ja: 'レ�����カセ�����ミッ�����テー���',\n      vi: 'Băng cassette cổ điển'\n    },\n    definition: '1980s paper textures, cassette labels, marker handwriting, worn stickers, torn album covers, faded ink, plastic tape reflections, analog music magazine clippings, bedroom wall nostalgia, stereo equipment fragments, handwritten tracklist details, soft dust, warm vintage colors.'\n  },\n  {\n    id: 'comic',\n    name: {\n      en: 'Underground comic',\n      es: 'Cómic underground',\n      ja: 'ア�����ーグ�����ンド�����ミッ���',\n      vi: 'Truyện tranh underground'\n    },\n    definition: 'Rough ink drawings, halftone print texture, torn comic panels, exaggerated character cutouts, bold comic shadows, messy marker notes, gritty newsprint paper, rebellious indie magazine energy, crooked panel borders, heavy crosshatching, photocopied ink bleed, loud graphic storytelling.'\n  },\n  {\n    id: 'luxury',\n    name: {\n      en: 'Luxury magazine',\n      es: 'Revista de lujo',\n      ja: '高�����ァッ�����ン誌',\n      vi: 'Tạp chí xa xỉ'\n    },\n    definition: 'High-fashion luxury magazine collage style, clean cut paper edges, glossy editorial photography, elegant negative space, refined shadows, premium matte paper, sophisticated layout, subtle grain, modern art magazine composition, polished product-advertising feel, precise alignment, rich textures, stylish contrast, upscale visual branding.'\n  },\n  {\n    id: 'street_art',\n    name: {\n      en: 'Street art wheatpaste',\n      es: 'Cartel de arte callejero',\n      ja: 'ス�����ート�����トの�����ター',\n      vi: 'Nghệ thuật dán poster đường phố'\n    },\n    definition: 'Ripped wall posters, spray paint marks, stencil shapes, torn layers, rough concrete texture, paste residue, graffiti marker scribbles, weathered ink, rebellious city-wall collage, overlapping event flyers, sun-faded paper, chipped paint, urban grit, bold public-art energy.'\n  },\n  {\n    id: 'ransom_note',\n    name: {\n      en: 'Ransom-note typography',\n      es: 'Tipografía de nota de rescate',\n      ja: '脅�����風タ�����グラ�����',\n      vi: 'Chữ cắt dán kiểu thư tống tiền'\n    },\n    definition: 'Mismatched magazine letters, torn paper fragments, uneven tape, harsh shadows, photocopy grain, chaotic cut-and-paste layout, jagged edges, handmade imperfection, gritty thriller poster mood, ransom-style word assembly, high contrast paper scraps, tense visual rhythm.'\n  },\n  {\n    id: 'craft_paper',\n    name: {\n      en: 'Handmade craft paper',\n      es: 'Papel artesanal',\n      ja: '手�����クラ�����ペー�����',\n      vi: 'Giấy thủ công làm bằng tay'\n    },\n    definition: 'Colored construction paper, visible glue marks, soft paper shadows, rounded scissor-cut edges, crayon scribbles, playful stickers, simple handmade shapes, cheerful classroom poster feeling, tactile paper layers, childlike composition, bright friendly colors, imperfect charming details.'\n  },\n  {\n    id: 'museum',\n    name: {\n      en: 'Contemporary museum assemblage',\n      es: 'Ensamblaje de museo contemporáneo',\n      ja: '現�����術館�����サン�����ージ���',\n      vi: 'Nghệ thuật lắp ghép bảo tàng hiện đ��i'\n    },\n    definition: 'Layered archival paper, precise cutouts, subtle shadows, textured matte surface, abstract composition, gallery lighting, restrained color palette, refined handmade art object feel, sculptural paper depth, quiet negative space, clean edges, delicate material contrast.'\n  },\n  {\n    id: 'psychedelic',\n    name: {\n      en: 'Psychedelic rock',\n      es: 'Rock psicodélico',\n      ja: 'サ�����デリ�����・ロ�����',\n      vi: 'Rock ảo giác'\n    },\n    definition: 'Swirling paper shapes, saturated retro colors, warped magazine cutouts, liquid patterns, hand-drawn ink lines, vintage screen-print grain, trippy composition, 1960s concert poster energy, kaleidoscopic layering, wavy borders, surreal instruments, hypnotic visual flow.'\n  },\n  {\n    id: 'noir',\n    name: {\n      en: 'Noir detective',\n      es: 'Detective noir',\n      ja: 'ノ�����ル・�����テク�����ブ',\n      vi: 'Thám tử Noir'\n    },\n    definition: 'Black-and-white newspaper clippings, smoky shadows, torn crime photos, red marker circles, old typewriter labels, tape, grainy photocopy texture, moody paper layers, mystery board aesthetic, pinned evidence fragments, dramatic contrast, rain-stained paper, investigative thriller atmosphere.'\n  },\n  {\n    id: 'scientific',\n    name: {\n      en: 'Scientific field-note',\n      es: 'Notas de campo científicas',\n      ja: '科�����なフ�����ルド�����ト',\n      vi: 'Ghi chép khoa học thực đ��a'\n    },\n    definition: 'Notebook paper, specimen labels, taped photographs, pencil annotations, diagram fragments, aged paper texture, careful catalog layout, subtle xerox grain, handmade research journal aesthetic, measurement marks, archival stamps, microscope-photo cutouts, organized discovery-board composition.'\n  },\n  {\n    id: 'album_cover',\n    name: {\n      en: 'Alternative album cover',\n      es: 'Portada de álbum alternativo',\n      ja: 'オ�����ナテ�����・ア�����ムカ�����',\n      vi: 'Bìa album thay thế'\n    },\n    definition: 'Torn band photos, abstract paper shapes, scratched textures, faded stickers, distressed typography feel, analog print grain, emotional grunge atmosphere, bold central composition, moody lighting, rough poster edges, layered soundwave graphics, raw independent music identity.'\n  },\n  {\n    id: 'newspaper',\n    name: {\n      en: 'Newspaper editorial',\n      es: 'Editorial de periódico',\n      ja: '新�����エデ�����リア���',\n      vi: 'Biên tập báo chí'\n    },\n    definition: 'Black-and-white press photos, torn headlines, column text fragments, ink smears, newsprint texture, red pencil marks, rough tape, urgent magazine layout, documentary poster feel, layered reportage clippings, editorial tension, bold cropping, serious journalistic mood.'\n  },\n  {\n    id: 'digital_paper',\n    name: {\n      en: 'Clean digital paper',\n      es: 'Papel digital limpio',\n      ja: 'ク�����ンな�����タル�����パー',\n      vi: 'Collage giấy kỹ thuật số sạch'\n    },\n    definition: 'Crisp cutout edges, soft realistic paper shadows, subtle grain, organized layered composition, modern color palette, polished editorial design, handmade feel with clean professional finish, precise spacing, refined textures, balanced hierarchy, smooth studio lighting, contemporary social-media ready layout.'\n  },\n  {\n    id: 'infographic',\n    name: {\n      en: 'Infographic collage',\n      es: 'Collage infográfico',\n      ja: 'イ�����ォグ�����ィッ�����コラ�����ュ',\n      vi: 'Collage đ�� họa thông tin'\n    },\n    definition: 'Data-driven visual elements, torn graph paper, vintage charts, pie-chart cutouts, diagrammatic arrows, numbered labels, ruler edges, educational magazine layout, clean geometric shapes mixed with rough paper textures, informational hierarchy, bold typography, schematic drawing fragments, analytical yet handmade aesthetic, visually explaining concepts through cut-and-paste graphics.'\n  }\n];"},{"path":"App.tsx","content":"import React, { useState, useEffect, useRef } from 'react';\nimport { Step1VideoGen } from './components/Step1VideoGen';\nimport { Step2Preview } from './components/Step2Preview';\nimport { LanguageGate } from './components/LanguageGate';\nimport { GeneratedVideo, LanguageCode } from './types';\nimport { TRANSLATIONS } from './translations';\nimport { SUPPORTED_LANGUAGES } from './constants/Languages';\n\nexport default function App() {\n  const [langCode, setLangCode] = useState<LanguageCode | null>(null);\n  const [activeVideo, setActiveVideo] = useState<GeneratedVideo | null>(null);\n  const [aspectRatio, setAspectRatio] = useState<'16:9' | '9:16'>('16:9');\n\n  const previewRef = useRef<HTMLDivElement>(null);\n  const t = langCode && TRANSLATIONS[langCode] ? TRANSLATIONS[langCode] : TRANSLATIONS['en'];\n\n  // Auto-scroll effect\n  useEffect(() => {\n    if (activeVideo && previewRef.current) {\n      const timer = setTimeout(() => {\n        previewRef.current?.scrollIntoView({ \n          behavior: 'smooth', \n          block: 'center' \n        });\n      }, 100);\n      return () => clearTimeout(timer);\n    }\n  }, [activeVideo]);\n\n  useEffect(() => {\n    const id = 'collage-video-global-css';\n    if (document.getElementById(id)) return;\n    const style = document.createElement('style');\n    style.id = id;\n    style.textContent = `\n      .light-scrollbar::-webkit-scrollbar { width: 6px; }\n      .light-scrollbar::-webkit-scrollbar-track { background: transparent; }\n      .light-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }\n      \n      html, body, #root { \n        background: #fcfcfc; \n        color: #1a1a1a; \n        min-height: 100%; \n        margin: 0; \n        padding: 0; \n        font-family: 'Google Sans Text', 'Google Sans', -apple-system, BlinkMacSystemFont, sans-serif; \n        overflow-x: hidden; \n        scroll-behavior: smooth; \n        letter-spacing: 0.1px;\n      }\n\n      .graph-paper {\n        background-image: \n          linear-gradient(#00000008 1px, transparent 1px),\n          linear-gradient(90deg, #00000008 1px, transparent 1px),\n          linear-gradient(#0000000f 1px, transparent 1px),\n          linear-gradient(90deg, #0000000f 1px, transparent 1px);\n        background-size: 20px 20px, 20px 20px, 100px 100px, 100px 100px;\n      }\n\n      @keyframes shimmer-light { 0% { background-position: -200% 0; } 100% { background-position: 200% 0; } }\n      .animate-shimmer-light { \n        background: linear-gradient(90deg, transparent, rgba(0,0,0,0.03), transparent); \n        background-size: 200% 100%; \n        animation: shimmer-light 3s infinite linear; \n      }\n    `;\n    document.head.appendChild(style);\n  }, []);\n\n  if (!langCode) {\n    return <LanguageGate onSelect={setLangCode} />;\n  }\n\n  const currentLangLabel = SUPPORTED_LANGUAGES.find(l => l.code === langCode)?.nativeLabel;\n\n  return (\n    <div className=\"flex flex-col min-h-screen graph-paper p-6 pb-20 gap-8 overflow-y-auto light-scrollbar scroll-smooth\">\n      <div className=\"max-w-4xl mx-auto w-full flex flex-col md:flex-row md:items-center justify-between gap-4\">\n        <div className=\"animate-in fade-in slide-in-from-top-4 duration-700\">\n          <div className=\"flex items-center gap-2 mb-1\">\n             <span className=\"material-symbols-outlined text-[#21a351] text-[36px] rotate-12\">architecture</span>\n             <h1 className=\"text-3xl font-black text-slate-900 tracking-tight uppercase\">{t.headerTitle}</h1>\n          </div>\n          <p className=\"text-slate-500 text-sm font-semibold pl-1\">\n            {t.headerSub}\n          </p>\n        </div>\n        \n        <button \n          onClick={() => setLangCode(null)}\n          className=\"flex items-center gap-2 px-5 py-2.5 bg-white border-2 border-slate-200 rounded-2xl hover:border-[#21a351] hover:text-[#21a351] transition-all group active:scale-95 shadow-md\"\n        >\n          <span className=\"material-symbols-outlined text-[20px] text-slate-400 group-hover:text-[#21a351]\">language</span>\n          <span className=\"text-sm font-bold\">{currentLangLabel}</span>\n          <span className=\"material-symbols-outlined text-[16px] text-slate-300\">expand_more</span>\n        </button>\n      </div>\n\n      <div className=\"flex flex-col gap-8 animate-in fade-in slide-in-from-bottom-6 duration-1000 delay-150\">\n        <Step1VideoGen \n          onVideoGen={setActiveVideo} \n          langCode={langCode}\n          t={t}\n          aspectRatio={aspectRatio}\n          setAspectRatio={setAspectRatio}\n        />\n\n        <div ref={previewRef} className=\"scroll-mt-20\">\n          <Step2Preview \n            video={activeVideo}\n            t={t}\n            aspectRatio={aspectRatio}\n          />\n        </div>\n      </div>\n\n      {activeVideo && (\n        <div className=\"fixed bottom-8 left-1/2 -translate-x-1/2 flex items-center gap-4 p-2 pr-6 bg-slate-900 text-white rounded-[32px] shadow-2xl animate-in slide-in-from-bottom-12 duration-700 z-50\">\n           <div className=\"flex items-center gap-3 px-4 py-3 bg-white rounded-[24px] shadow-lg border-2 border-slate-100\">\n              <div className=\"w-9 h-9 rounded-xl bg-[#21a351] flex items-center justify-center overflow-hidden\">\n                <span className=\"material-symbols-outlined text-white text-[20px] font-bold\">auto_awesome</span>\n              </div>\n              <div className=\"flex flex-col pr-2\">\n                <span className=\"text-[9px] font-black text-slate-400 uppercase leading-none\">{activeVideo.duration}s Cutout</span>\n                <span className=\"text-[10px] font-black text-slate-900 uppercase tracking-wider\">{t.shareTitle}</span>\n              </div>\n            </div>\n            \n            <div className=\"pl-4 border-l border-white/20 flex items-center gap-4\">\n              <div className=\"flex flex-col items-end\">\n                <span className=\"text-[10px] font-bold text-white/50 uppercase leading-none\">{aspectRatio}</span>\n                <span className=\"text-[12px] font-black text-white uppercase tracking-widest\">{t.readyToDownload}</span>\n              </div>\n              <div className=\"w-9 h-9 rounded-full bg-[#21a351] flex items-center justify-center border-2 border-white/20\">\n                <span className=\"material-symbols-outlined text-white text-[22px] font-bold\">check</span>\n              </div>\n            </div>\n        </div>\n      )}\n    </div>\n  );\n}"},{"path":"translations.ts","content":"import { TranslationStrings } from './types';\n\nexport const TRANSLATIONS: Record<string, TranslationStrings> = {\n  en: {\n    languageSelectTitle: \"Region & Language\",\n    languageSelectSub: \"Choose your primary language to optimize script generation and UI typography.\",\n    languageSelectAction: \"Get Started\",\n    welcomeTitle: \"Welcome to CollageMotion Pro\",\n    welcomeIntro: \"Transform your imagination into tactile, stop-motion paper collage masterpieces.\",\n    welcomeStep1: \"1. Set Your Language\",\n    welcomeStep1Sub: \"Choose your native tongue to customize the AI scriptwriter and interface.\",\n    welcomeStep2: \"2. Design Your Scene\",\n    welcomeStep2Sub: \"Describe your visual vision and select a unique tactile collage art style.\",\n    welcomeStep3: \"3. Neural Rendering\",\n    welcomeStep3Sub: \"Our neural engine renders your imagination into a high-fidelity video.\",\n    headerTitle: \"CollageMotion Pro\",\n    headerSub: \"Generate stylized collage-art videos directly from your imagination.\",\n    step1Title: \"Configure Scene\",\n    step1Sub: \"Visual & Narrative Input\",\n    inputLabel: \"Configuration\",\n    inputPlaceholder: \"Describe the world you want to create...\",\n    sceneLabel: \"Scene Description\",\n    scenePlaceholder: \"E.g., a mystic neon forest with floating islands...\",\n    scriptLabel: \"Script / Dialogue\",\n    scriptPlaceholder: \"E.g., the ancient trees whisper secrets of the moon...\",\n    autoGenScript: \"Auto-generate script\",\n    styleLabel: \"Artistic Style\",\n    durationLabel: \"Video Duration\",\n    aspectLabel: \"Aspect Ratio\",\n    audioTitle: \"Audio Experience\",\n    voiceLabel: \"Narrator Voice\",\n    musicLabel: \"Background Music\",\n    voiceFemale: \"Female\",\n    voiceMale: \"Male\",\n    voiceNone: \"SFX Only\",\n    musicOn: \"Music On\",\n    musicOff: \"Music Off\",\n    genBtn: \"Create Collage Video\",\n    genLoading: \"Rendering (1-2 mins)...\",\n    errorInput: \"Please enter a scene description.\",\n    errorGen: \"Failed to generate video. Please try again.\",\n    errorVoiceScript: \"Please input a script first to enable narrator voices.\",\n    step2Title: \"Preview & Export\",\n    step2Sub: \"Final Living Paper Masterpiece\",\n    step2Desc: \"Your video has been rendered as a Living Paper scene. It features tactile textures, parallax depth, and stop-motion animation.\",\n    downloadBtn: \"Download\",\n    downloadVideo: \"Download MP4\",\n    shareTitle: \"Masterpiece Ready\",\n    processingStage: \"Neural Rendering\",\n    readyToDownload: \"Ready to Export\"\n  },\n  es: {\n    languageSelectTitle: \"Región e Idioma\",\n    languageSelectSub: \"Elige tu idioma principal para optimizar la generación de guiones y la tipografía de la interfaz.\",\n    languageSelectAction: \"Empezar\",\n    welcomeTitle: \"Bienvenido a CollageMotion Pro\",\n    welcomeIntro: \"Transforma tu imaginación en obras maestras de collage de papel táctiles y stop-motion.\",\n    welcomeStep1: \"1. Configura tu Idioma\",\n    welcomeStep1Sub: \"Elige tu lengua materna para optimizar el guionista de IA y la interfaz.\",\n    welcomeStep2: \"2. Diseña tu Escena\",\n    welcomeStep2Sub: \"Describe tu visión visual y selecciona un estilo de arte collage único.\",\n    welcomeStep3: \"3. Renderizado Neuronal\",\n    welcomeStep3Sub: \"Nuestro motor neuronal renderiza tu imaginación en un video de alta fidelidad.\",\n    headerTitle: \"CollageMotion Pro\",\n    headerSub: \"Genera videos de arte collage estilizados directamente desde tu imaginación.\",\n    step1Title: \"Configurar Escena\",\n    step1Sub: \"Entrada Visual y Narrativa\",\n    inputLabel: \"Configuration\",\n    inputPlaceholder: \"Describe el mundo que quieres crear...\",\n    sceneLabel: \"Descripción de la Escena\",\n    scenePlaceholder: \"Ej. un bosque místico con islas flotantes...\",\n    scriptLabel: \"Guion / Diálogo\",\n    scriptPlaceholder: \"Ej. los árboles susurran secretos de la luna...\",\n    autoGenScript: \"Generar guion automáticamente\",\n    styleLabel: \"Estilo Artístico\",\n    durationLabel: \"Duración del Video\",\n    aspectLabel: \"Relación de Aspecto\",\n    audioTitle: \"Experiencia de Audio\",\n    voiceLabel: \"Voz del Narrador\",\n    voiceFemale: \"Femenina\",\n    voiceMale: \"Masculina\",\n    voiceNone: \"Solo Efectos\",\n    musicLabel: \"Música de Fondo\",\n    musicOn: \"Música Sí\",\n    musicOff: \"Sin Música\",\n    genBtn: \"Crear Video Collage\",\n    genLoading: \"Renderizando (1-2 min)...\",\n    errorInput: \"Por favor, introduce una descripción de la escena.\",\n    errorGen: \"Error al generar el video. Inténtalo de nuevo.\",\n    errorVoiceScript: \"Introduce un guion primero para activar las voces del narrador.\",\n    step2Title: \"Previsualizar y Exportar\",\n    step2Sub: \"Obra Maestra Final de Papel Vivo\",\n    step2Desc: \"Tu video ha sido renderizado como una escena de Papel Vivo. Presenta texturas táctiles, profundidad de paralaje y animación stop-motion.\",\n    downloadBtn: \"Descargar\",\n    downloadVideo: \"Descargar MP4\",\n    shareTitle: \"Obra Maestra Lista\",\n    processingStage: \"Renderizado Neuronal\",\n    readyToDownload: \"Listo para Exportar\"\n  },\n  ja: {\n    languageSelectTitle: \"地�����言語\",\n    languageSelectSub: \"ス�����プト�����とUIタ�����グラ�����を最�����する�����に、�����な言�����選択�����くだ�����。\",\n    languageSelectAction: \"は�����る\",\n    welcomeTitle: \"CollageMotion Pro へ�����こそ\",\n    welcomeIntro: \"あ�����の想�����を、�����的で�����ップ�����ショ�����よう�����のコ�����ジュ�����作に�����まし�����。\",\n    welcomeStep1: \"1. 言�����設定\",\n    welcomeStep1Sub: \"AIス�����プト�����ター�����ンタ�����ェー�����最適�����るた�����母国�����選択�����くだ�����。\",\n    welcomeStep2: \"2. シ�����のデ�����ン\",\n    welcomeStep2Sub: \"ビ�����アル�����ョン�����明し�����ニー�����コラ�����ュア�����スタ�����を選�����てく�����い。\",\n    welcomeStep3: \"3. ニ�����ラル�����ダリ�����\",\n    welcomeStep3Sub: \"当�����ニュ�����ルエ�����ンが�����たの�����力を�����細ビ�����にレ�����リン�����ます���\",\n    headerTitle: \"CollageMotion Pro\",\n    headerSub: \"想�����から�����、ス�����リッ�����なコ�����ジュ�����トビ�����を生�����ます���\",\n    step1Title: \"シ�����の設���\",\n    step1Sub: \"ビ�����アル�����ラテ�����の入���\",\n    inputLabel: \"構���\",\n    inputPlaceholder: \"作�����たい�����を説�����てく�����い...\",\n    sceneLabel: \"シ�����の説���\",\n    scenePlaceholder: \"例�����遊島�����る神�����な森...\",\n    scriptLabel: \"ス�����プト / 台���\",\n    scriptPlaceholder: \"例�����木が�����秘密�����く...\",\n    autoGenScript: \"ス�����プト�����動生�����る\",\n    styleLabel: \"芸�����なス�����ル\",\n    durationLabel: \"ビ�����の長���\",\n    aspectLabel: \"ア�����クト���\",\n    audioTitle: \"オ�����ィオ�����\",\n    voiceLabel: \"ナ�����ター�����\",\n    voiceFemale: \"女���\",\n    voiceMale: \"男���\",\n    voiceNone: \"効�����のみ\",\n    musicLabel: \"背�����楽\",\n    musicOn: \"音�����り\",\n    musicOff: \"音�����し\",\n    genBtn: \"コ�����ジュ�����オを�����\",\n    genLoading: \"レ�����リン����� (1〜2分)...\",\n    errorInput: \"シ�����の説�����入力�����くだ�����。\",\n    errorGen: \"ビ�����の生�����失敗�����した�����う一�����試し�����さい���\",\n    errorVoiceScript: \"ナ�����ター�����を有�����する�����、ま�����クリ�����を入�����てく�����い。\",\n    step2Title: \"プ�����ュー�����クス�����ト\",\n    step2Sub: \"最�����なリ�����グペ�����ーの�����\",\n    step2Desc: \"ビ�����は「�����ング�����パー�����ーン�����てレ�����リン�����れま�����。触�����なテ�����チャ�����ララ�����スの�����き、�����ップ�����ショ�����ニメ�����ョン�����徴で�����\",\n    downloadBtn: \"ダ�����ロー���\",\n    downloadVideo: \"MP4を�����ンロ�����\",\n    shareTitle: \"傑�����完成�����した\",\n    processingStage: \"ニ�����ラル�����ダリ�����\",\n    readyToDownload: \"エ�����ポー�����準備�����\"\n  },\n  vi: {\n    languageSelectTitle: \"Vùng & Ngôn Ngữ\",\n    languageSelectSub: \"Chọn ngôn ngữ chính đ�� tối ưu hóa việc tạo kịch bản và phông chữ giao diện.\",\n    languageSelectAction: \"Bắt Đ��u\",\n    welcomeTitle: \"Chào mừng đ��n với CollageMotion Pro\",\n    welcomeIntro: \"Biến trí tư��ng tư��ng của bạn thành những tác phẩm nghệ thuật cắt dán giấy stop-motion sống đ��ng.\",\n    welcomeStep1: \"1. Thiết Lập Ngôn Ngữ\",\n    welcomeStep1Sub: \"Chọn tiếng mẹ đ�� đ�� tối ưu hóa trình viết kịch bản AI và giao diện.\",\n    welcomeStep2: \"2. Thiết Kế Cảnh Quay\",\n    welcomeStep2Sub: \"Mô tả tầm nhìn của bạn và chọn một phong cách nghệ thuật collage đ��c đáo.\",\n    welcomeStep3: \"3. Render Thần Kinh\",\n    welcomeStep3Sub: \"Công cụ thần kinh của chúng tôi chuyển đ��i trí tư��ng tư��ng của bạn thành video chất lư��ng cao.\",\n    headerTitle: \"CollageMotion Pro\",\n    headerSub: \"Tạo video nghệ thuật collage đ��y phong cách trực tiếp từ trí tư��ng tư��ng của bạn.\",\n    step1Title: \"Cấu Hình Cảnh\",\n    step1Sub: \"Đ��u Vào Hình Ảnh & Nội Dung\",\n    inputLabel: \"Cấu hình\",\n    inputPlaceholder: \"Mô tả thế giới bạn muốn tạo ra...\",\n    sceneLabel: \"Mô Tả Cảnh\",\n    scenePlaceholder: \"VD: một khu rừng místico với các đ��o bay...\",\n    scriptLabel: \"Kịch Bản / Lời Thoại\",\n    scriptPlaceholder: \"VD: những cái cây cổ thụ thì thầm bí mật của trăng...\",\n    autoGenScript: \"Tự đ��ng tạo kịch bản\",\n    styleLabel: \"Phong Cách Nghệ Thuật\",\n    durationLabel: \"Thời Lư��ng Video\",\n    aspectLabel: \"Tỷ Lệ Khung Hình\",\n    audioTitle: \"Trải Nghiệm Âm Thanh\",\n    voiceLabel: \"Giọng Ngư��i Dẫn\",\n    voiceFemale: \"Nữ\",\n    voiceMale: \"Nam\",\n    voiceNone: \"Chỉ Hiệu Ưng\",\n    musicLabel: \"Nhạc Nền\",\n    musicOn: \"Có Nhạc\",\n    musicOff: \"Không Nhạc\",\n    genBtn: \"Tạo Video Collage\",\n    genLoading: \"Đang Render (1-2 phút)...\",\n    errorInput: \"Vui lòng nhập mô tả cảnh.\",\n    errorGen: \"Không thể tạo video. Vui lòng thử lại.\",\n    errorVoiceScript: \"Vui lòng nhập kịch bản trư��c đ�� kích hoạt giọng nói ngư��i dẫn.\",\n    step2Title: \"Xem Trư��c & Xuất File\",\n    step2Sub: \"Tác Phẩm Giấy Sống Cuối Cùng\",\n    step2Desc: \"Video của bạn đã được render thành một cảnh 'Giấy Sống'. Nó có các vân giấy xúc giác, đ�� sâu parallax và hoạt ảnh stop-motion.\",\n    downloadBtn: \"Tải về\",\n    downloadVideo: \"Tải MP4\",\n    shareTitle: \"Tác Phẩm Đã Sẵn Sàng\",\n    processingStage: \"Render Thần Kinh\",\n    readyToDownload: \"Sẵn Sàng Xuất File\"\n  }\n};"},{"path":"constants/Languages.ts","content":"import { LanguageInfo } from '../types';\n\nexport const SUPPORTED_LANGUAGE